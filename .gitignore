# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Data artefacts (regenerated by scripts, not version-controlled)
data/tables/
data/processed/
data/raw/
*.db
*.sqlite

# Model weights and adapters (large; regenerated by training)
# NOTE: `models/*` not `models/`. Git cannot re-include a file whose parent
# directory is excluded, so `models/` + `!models/.gitkeep` silently fails to
# keep the placeholder. Excluding the directory *contents* lets the negation work.
models/*
!models/.gitkeep

# Downloaded wheels. torch's CUDA wheel is ~1.8 GB and lands in the project
# root when downloaded manually for a resumable install (see docs/SETUP.md).
# GitHub rejects files over 100 MB, so an un-ignored wheel fails the push.
*.whl

# HuggingFace cache if redirected locally
.hf_cache/

# Reports are COMMITTED on purpose (baseline_metrics.json must be locked in
# before fine-tuning starts), so reports/ is deliberately NOT ignored.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
